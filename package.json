{
  "name": "bracket",
  "version": "1.0.0",
  "description": "Live bracket for the Players Era men's college basketball tournaments in Las Vegas, powered by ESPN's public scoreboard API.",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch-path=server --watch-path=index.js index.js\" \"vite\"",
    "build": "vite build",
    "start": "node index.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
